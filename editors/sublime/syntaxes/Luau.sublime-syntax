%YAML 1.2
---
# http://www.sublimetext.com/docs/syntax.html
#
# Ported from the Luau grammar shipped with luwu-lsp:
#   ../../code/syntaxes/Luau.tmLanguage.json
# which itself descends from https://github.com/JohnnyMorganz/Luau.tmLanguage
#
# Keep it in sync with Luwu.sublime-syntax by hand: a change to shared syntax
# goes in both files. Keyword-like names that are plain identifiers in Luau
# (`none`, `final`, `trait`, `expect`, ...) and Luwu-only directives (`--!trust`)
# are deliberately not highlighted here.
name: Luau
file_extensions:
  - luau
  - lua
scope: source.luau
contexts:
  main:
    - include: function-definition
    - include: number
    - include: string
    - include: shebang
    - include: comment
    - include: local-declaration
    - include: const-declaration
    - include: extern-type-declaration
    - include: declare-function
    - include: declare-variable
    - include: class-declaration
    - include: public-declaration
    - include: private-declaration
    - include: for-loop
    - include: type-function
    - include: type-alias-declaration
    - include: keyword
    - include: language_constant
    - include: standard_library
    - include: generics-instantiation
    - include: identifier
    - include: operator
    - include: parentheses
    - include: table
    - include: type_cast
    - include: type_annotation
    - include: attribute

  comment:
    # A `--[[ ... ]]` / `--[=[ ... ]=]` block comment. Only its delimiters and prose
    # are scoped as a comment, not the whole block, so code in a ```luwu / ```luau
    # fence inside it is scoped purely as code and highlights like it would outside
    # the comment.
    - match: '--\[(=*)\['
      scope: comment.block.luau
      push:
        - match: '\]\1\]'
          scope: comment.block.luau
          pop: true
        - match: '(```luwu)\s*$'
          captures:
            1: comment.block.luau
          push:
            - meta_content_scope: meta.embedded.block.luwu
            - match: '^(?=\s*```)'
              pop: true
            - include: scope:source.luwu
        - match: '(```luau?)\s*$'
          captures:
            1: comment.block.luau
          push:
            - meta_content_scope: meta.embedded.block.luau
            - match: '^(?=\s*```)'
              pop: true
            - include: scope:source.luau
        - match: '(```)'
          scope: comment.block.luau
        - include: doc_comment_tags
        # Comment prose. Stops at `]`, a backtick and `@` so the end delimiter,
        # fences and doc tags can still match.
        - match: '[^\]`@]+'
          scope: comment.block.luau
        - match: '[\]`@]'
          scope: comment.block.luau
    - match: '(--!)(optimize|native)\b'
      captures:
        1: keyword.operator.directive.luau
        2: keyword.control.directive.luau
      push:
        - meta_scope: meta.directive.codegen.luau
        - match: \n
          pop: true
        - match: '\S+'
          scope: variable.parameter.directive.luau
    - match: '(--!)(strict|nonstrict|nocheck|nolint)\b'
      captures:
        1: keyword.operator.directive.luau
        2: storage.modifier.directive.luau
      push:
        - meta_scope: meta.directive.luau
        - match: \n
          pop: true
        - match: '\S+'
          scope: variable.parameter.directive.luau
    - match: '---'
      push:
        - meta_scope: comment.line.double-dash.documentation.luau
        - match: \n
          pop: true
        - include: doc_comment_tags
    - match: '--'
      push:
        - meta_scope: comment.line.double-dash.luau
        - match: \n
          pop: true

  doc_comment_tags:
    - match: '((?<=[\s*!\/])[\\@]param)(?:\s)+(\b\w+\b)'
      captures:
        1: storage.type.class.luadoc.luau
        2: variable.parameter.luau
    - match: '((?<=[\s*!\/])[\\@]return)(?:\s)+(\b\w+\b)'
      captures:
        1: storage.type.class.luadoc.luau
        2: variable.parameter.luau
    - match: '((?<=[\s*!\/])[\\@]type)(?:\s)+(\b\w+\b)'
      captures:
        1: storage.type.class.luadoc.luau
        2: entity.name.type.luau
    - match: '((?<=[\s*!\/])[\\@]field)(?:\s)+(\b\w+\b)'
      captures:
        1: storage.type.class.luadoc.luau
        2: variable.other.property.luau
    - match: '@\w+'
      scope: storage.type.class.luadoc.luau

  # An attribute, bare (`@native`) or as a bracketed list
  # (`@[deprecated { reason = "whatever", use = "whatever" }, native]`). Only the
  # bracketed form takes arguments.
  attribute:
    - match: '(@)(\[)'
      captures:
        1: keyword.operator.attribute.luau
        2: punctuation.definition.attribute.begin.luau
      push:
        - meta_scope: meta.attribute.luau
        - match: '(\])'
          captures:
            1: punctuation.definition.attribute.end.luau
          pop: true
        - include: comment
        - match: ','
          scope: punctuation.separator.attribute.luau
        # One entry: the attribute's name, then its literal arguments -- a string,
        # a table or a parenthesized list.
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          captures:
            1: storage.type.attribute.luau
          push:
            - match: '(?=[,\]])'
              pop: true
            - include: comment
            - include: string
            - include: number
            - include: language_constant
            - include: table
            - include: parentheses
    - match: '(@)([a-zA-Z_][a-zA-Z0-9_]*)'
      scope: meta.attribute.luau
      captures:
        1: keyword.operator.attribute.luau
        2: storage.type.attribute.luau

  for-loop:
    - match: \b(for)\b
      captures:
        1: keyword.control.luau
      push:
        - match: \b(in)\b|(=)
          captures:
            1: keyword.control.luau
            2: keyword.operator.assignment.luau
          pop: true
        - match: (:)
          captures:
            1: keyword.operator.type.luau
          push:
            - match: '(?=\s*in\b|\s*[=,]|\s*$)'
              pop: true
            - include: type_literal
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: variable.parameter.luau

  function-definition:
    - match: '\b(?:(export)\s+)?(?:(public)\s+|(private)\s+|(local)\s+|(const)\s+)?(function)\b(?![,:])'
      captures:
        1: storage.modifier.visibility.luau
        2: storage.modifier.access.luau
        3: storage.modifier.access.luau
        4: storage.modifier.local.luau
        5: storage.modifier.const.luau
        6: keyword.control.luau
      push:
        - meta_scope: meta.function.luau
        - match: '(?<=[\)\-{}\[\]"''])'
          pop: true
        - include: comment
        - include: generics-declaration
        - include: function-parameters
        - match: \b(__add|__call|__concat|__div|__eq|__index|__le|__len|__lt|__metatable|__mod|__mode|__mul|__newindex|__pow|__sub|__tostring|__unm|__iter|__idiv)\b
          scope: variable.language.metamethod.luau
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: entity.name.function.luau

  function-parameters:
    - match: (\()
      captures:
        1: punctuation.definition.parameters.begin.luau
      push:
        - meta_scope: meta.parameter.luau
        - match: (\))
          captures:
            1: punctuation.definition.parameters.end.luau
          pop: true
        - include: comment
        - match: \.\.\.
          scope: variable.parameter.function.varargs.luau
        - match: '[a-zA-Z_][a-zA-Z0-9_]*'
          scope: variable.parameter.function.luau
        - match: ','
          scope: punctuation.separator.arguments.luau
        - match: ':'
          captures:
            0: keyword.operator.type.luau
          push:
            - match: '(?=[\),])'
              pop: true
            - include: type_literal

  # `declare function name(params): Return` -- a function with no body, from a
  # definition file.
  declare-function:
    - match: '\b(declare)\s+(function)\b'
      captures:
        1: storage.modifier.declare.luau
        2: keyword.control.luau
      push:
        - meta_scope: meta.function.declare.luau
        - match: '(?<=[\)\-{}\[\]"''])'
          pop: true
        - include: comment
        - include: generics-declaration
        - include: function-parameters
        - match: \b(__add|__call|__concat|__div|__eq|__index|__le|__len|__lt|__metatable|__mod|__mode|__mul|__newindex|__pow|__sub|__tostring|__unm|__iter|__idiv)\b
          scope: variable.language.metamethod.luau
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: entity.name.function.luau

  # `declare name: Type` -- a global from definition files.
  declare-variable:
    - match: '(?<![^.]\.|:)\b(declare)\s+(?!(?:function|extern|class)\b)([a-zA-Z_][a-zA-Z0-9_]*)\b(?=\s*:)'
      captures:
        1: storage.modifier.declare.luau
        2: variable.other.readwrite.luau

  # `declare extern type Name<T> extends Base with ... end` from definition files.
  # `declare` and `with` are optional here only so the `extern type Name ... end`
  # summaries shown in hovers highlight too -- they are required in real Luau source.
  extern-type-declaration:
    - match: '(?<![^.]\.|:)\b(?:(declare)\s+)?(extern)\s+(type)\s+([a-zA-Z_][a-zA-Z0-9_]*)'
      captures:
        1: storage.modifier.declare.luau
        2: storage.modifier.extern.luau
        3: storage.type.luau
        4: entity.name.type.luau
      push:
        - meta_scope: meta.extern-type.luau
        - match: '\b(end)\b'
          captures:
            1: keyword.control.luau
          pop: true
        - include: comment
        - include: generics-declaration
        - match: '\b(extends)\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\.[a-zA-Z_][a-zA-Z0-9_]*)*)'
          captures:
            1: storage.modifier.extends.luau
            2: entity.name.type.luau
        - match: '\b(with)\b'
          scope: keyword.control.luau
        - include: function-definition
        - match: '[a-zA-Z_][a-zA-Z0-9_]*(?=\s*:)'
          scope: variable.other.property.luau
        - include: type_annotation

  class-declaration:
    - match: '(?<![^.]\.|:)\b(?:(export)\s+)?(class)\s+(?:([\w]+))\b'
      captures:
        1: storage.modifier.visibility.luau
        2: keyword.control.luau
        3: entity.name.type.luau
      push:
        - meta_scope: meta.class.luau
        - match: '(?<=[a-zA-Z0-9_>])(?!\s*<)(?!\s*\bextends\b)'
          pop: true
        - include: comment
        - include: generics-declaration
        - match: '\b(extends)\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\.[a-zA-Z_][a-zA-Z0-9_]*)*)'
          captures:
            1: storage.modifier.extends.luau
            2: entity.name.type.luau
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: entity.name.type.class.luau

  generics-declaration:
    - match: (<)
      push:
        - match: (>)
          pop: true
        - match: '[a-zA-Z_][a-zA-Z0-9_]*'
          scope: entity.name.type.luau
        - match: '='
          scope: keyword.operator.assignment.luau
        - include: type_literal

  # Explicit generic instantiation at a call site -- `f<<number>>(x)`.
  generics-instantiation:
    - match: (<<)
      captures:
        1: punctuation.definition.typeparameters.begin.luau
      push:
        - match: (>>)
          captures:
            1: punctuation.definition.typeparameters.end.luau
          pop: true
        - include: comment
        - include: type_literal

  identifier:
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b(?=\s*(?:<<|[({"'']|\[\[))'
      scope: entity.name.function.luau
    - match: '(?<=[^.]\.|:)\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      scope: variable.other.property.luau
    - match: '\b([A-Z_][A-Z0-9_]*)\b'
      scope: variable.other.constant.luau
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      scope: variable.other.readwrite.luau

  interpolated_string_expression:
    - match: '\{'
      captures:
        0: punctuation.definition.interpolated-string-expression.begin.luau
      push:
        - meta_scope: meta.template.expression.luau
        - meta_content_scope: meta.embedded.line.luau
        - match: '\}'
          captures:
            0: punctuation.definition.interpolated-string-expression.end.luau
          pop: true
        - include: scope:source.luau

  keyword:
    - match: \b(break|do|else|for|if|elseif|return|then|repeat|while|until|end|in|continue)\b
      scope: keyword.control.luau
    - match: \b(local)\b
      scope: storage.modifier.local.luau
    - match: '\b(function)\b(?![,:])'
      scope: keyword.control.luau
    - match: '(?<![^.]\.|:)\b(self)\b'
      scope: variable.language.self.luau
    - match: \b(and|or|not)\b
      scope: keyword.operator.logical.luau keyword.operator.wordlike.luau
    - match: '(?<=[^.]\.|:)\b(__add|__call|__concat|__div|__eq|__index|__le|__len|__lt|__metatable|__mod|__mode|__mul|__newindex|__pow|__sub|__tostring|__unm)\b'
      scope: variable.language.metamethod.luau
    - match: '(?<![.])\.{3}(?!\.)'
      scope: keyword.other.unit.luau

  language_constant:
    - match: '(?<![^.]\.|:)\b(false)\b'
      scope: constant.language.boolean.false.luau
    - match: '(?<![^.]\.|:)\b(true)\b'
      scope: constant.language.boolean.true.luau
    - match: '(?<![^.]\.|:)\b(nil(?!:))\b'
      scope: constant.language.nil.luau

  local-declaration:
    - match: '\b(?:(export)\s+)?(local)\b'
      captures:
        1: storage.modifier.visibility.luau
        2: storage.modifier.local.luau
      push:
        - match: '(?=\s*do\b|\s*[=;])|^(?!\s*[|&])'
          pop: true
        - include: comment
        - include: attribute
        - match: (:)
          captures:
            1: keyword.operator.type.luau
          push:
            - match: '(?=\s*do\b|\s*[=;,])|^(?!\s*[|&])'
              pop: true
            - include: type_literal
        - match: '\b([A-Z_][A-Z0-9_]*)\b'
          scope: variable.other.constant.luau
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: variable.other.readwrite.luau

  const-declaration:
    - match: '\b(?:(export)\s+)?(const)\b'
      captures:
        1: storage.modifier.visibility.luau
        2: storage.modifier.const.luau
      push:
        - match: '(?=\s*[=;])|^(?!\s*[|&])'
          pop: true
        - include: comment
        - include: attribute
        - match: (:)
          captures:
            1: keyword.operator.type.luau
          push:
            - match: '(?=\s*[=;,])|^(?!\s*[|&])'
              pop: true
            - include: type_literal
        - match: '\b([A-Z_][A-Z0-9_]*)\b'
          scope: variable.other.constant.luau
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: variable.other.readwrite.luau

  public-declaration:
    - match: '\b(public)\b'
      captures:
        1: storage.modifier.access.luau
      push:
        - match: '(?=\s*[=;])|^(?!\s*[|&])'
          pop: true
        - include: comment
        - include: attribute
        - match: (:)
          captures:
            1: keyword.operator.type.luau
          push:
            - match: '(?=\s*[=;,])|^(?!\s*[|&])'
              pop: true
            - include: type_literal
        - match: '\b([A-Z_][A-Z0-9_]*)\b'
          scope: variable.other.constant.luau
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: variable.other.readwrite.luau

  private-declaration:
    - match: '\b(private)\b'
      captures:
        1: storage.modifier.access.luau
      push:
        - match: '(?=\s*[=;])|^(?!\s*[|&])'
          pop: true
        - include: comment
        - include: attribute
        - match: (:)
          captures:
            1: keyword.operator.type.luau
          push:
            - match: '(?=\s*[=;,])|^(?!\s*[|&])'
              pop: true
            - include: type_literal
        - match: '\b([A-Z_][A-Z0-9_]*)\b'
          scope: variable.other.constant.luau
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: variable.other.readwrite.luau

  number:
    - match: '\b0_*[xX]_*[\da-fA-F_]*(?:i|[eE][\+\-]?_*\d[\d_]*(?:\.[\d_]*)?)?'
      scope: constant.numeric.hex.luau
    - match: '\b0_*[bB][01_]+(?:i|[eE][\+\-]?_*\d[\d_]*(?:\.[\d_]*)?)?'
      scope: constant.numeric.binary.luau
    - match: '(?:\d[\d_]*(?:\.[\d_]*)?|\.\d[\d_]*)(?:i|[eE][\+\-]?_*\d[\d_]*(?:\.[\d_]*)?)?'
      scope: constant.numeric.decimal.luau

  operator:
    - match: '==|~=|<=?|>=?'
      scope: keyword.operator.comparison.luau
    - match: \+=|-=|/=|//=|\*=|%=|\^=|\.\.=|=
      scope: keyword.operator.assignment.luau
    - match: \+|-|%|\*|\/\/|\/|\^
      scope: keyword.operator.arithmetic.luau
    - match: '#|(?<!\.)\.{2}(?!\.)'
      scope: keyword.operator.other.luau

  parentheses:
    - match: (\()
      captures:
        1: punctuation.arguments.begin.luau
      push:
        - match: (\))
          captures:
            1: punctuation.arguments.end.luau
          pop: true
        - match: ','
          scope: punctuation.separator.arguments.luau
        - include: scope:source.luau

  shebang:
    - match: \A(#!).*$\n?
      scope: comment.line.shebang.luau
      captures:
        1: punctuation.definition.comment.luau

  standard_library:
    - match: '(?<![^.]\.|:)\b(assert|collectgarbage|error|gcinfo|getfenv|getmetatable|ipairs|loadstring|newproxy|next|pairs|pcall|print|rawequal|rawset|require|select|setfenv|setmetatable|tonumber|tostring|type|typeof|unpack|xpcall)\b'
      scope: support.function.luau
    - match: '(?<![^.]\.|:)\b(_G|_VERSION)\b'
      scope: constant.language.luau
    - match: '(?<![^.]\.|:)\b(bit32\.(?:arshift|band|bnot|bor|btest|bxor|extract|lrotate|lshift|replace|rrotate|rshift|countlz|countrz|byteswap)|coroutine\.(?:create|isyieldable|resume|running|status|wrap|yield|close)|debug\.(?:info|loadmodule|profilebegin|profileend|traceback)|integer\.(?:add|arshift|band|bnot|bor|bswap|btest|bxor|clamp|countlz|countrz|create|div|extract|fromstring|ge|gt|idiv|le|lrotate|lshift|lt|max|min|mod|mul|neg|rem|replace|rrotate|rshift|sub|tonumber|udiv|uge|ugt|ule|ult|urem)|math\.(?:abs|acos|asin|atan|atan2|ceil|clamp|cos|cosh|deg|exp|floor|fmod|frexp|isfinite|isinf|isnan|ldexp|lerp|log|log10|map|max|min|modf|noise|pow|rad|random|randomseed|round|sign|sin|sinh|sqrt|tan|tanh)|os\.(?:clock|date|difftime|time)|string\.(?:byte|char|find|format|gmatch|gsub|len|lower|match|pack|packsize|rep|reverse|split|sub|unpack|upper)|table\.(?:concat|create|find|foreach|foreachi|getn|insert|maxn|move|pack|remove|sort|unpack|clear|freeze|isfrozen|clone)|task\.(?:spawn|synchronize|desynchronize|wait|defer|delay)|utf8\.(?:char|codepoint|codes|graphemes|len|nfcnormalize|nfdnormalize|offset)|buffer\.(?:create|fromstring|tostring|len|readbits|readi8|readu8|readi16|readu16|readi32|readu32|readinteger|readf32|readf64|writebits|writei8|writeu8|writei16|writeu16|writei32|writeu32|writeinteger|writef32|writef64|readstring|writestring|copy|fill)|vector\.(?:abs|angle|ceil|clamp|create|cross|dot|floor|lerp|magnitude|max|min|normalize|sign))\b'
      scope: support.function.luau
    - match: '(?<![^.]\.|:)\b(bit32|buffer|coroutine|debug|integer(\.(maxsigned|minsigned))?|math(\.(huge|pi|nan|e|phi|sqrt2|tau))?|os|string|table|task|utf8(\.charpattern)?|vector(\.(one|zero))?)\b'
      scope: support.constant.luau
    - match: '(?<![^.]\.|:)\b(delay|DebuggerManager|elapsedTime|PluginManager|printidentity|settings|spawn|stats|tick|time|UserSettings|version|wait|warn)\b'
      scope: support.function.luau
    - match: '(?<![^.]\.|:)\b(game|plugin|shared|script|workspace|Enum(?:\.\w+){0,2})\b'
      scope: constant.language.luau

  string:
    - match: '"'
      push:
        - meta_scope: string.quoted.double.luau
        - match: '"'
          pop: true
        - include: string_escape
    - match: "'"
      push:
        - meta_scope: string.quoted.single.luau
        - match: "'"
          pop: true
        - include: string_escape
    - match: '\[(=*)\['
      push:
        - meta_scope: string.other.multiline.luau
        - match: '\]\1\]'
          pop: true
    - match: '`'
      push:
        - meta_scope: string.interpolated.luau
        - match: '`'
          pop: true
        - include: interpolated_string_expression
        - include: string_escape

  string_escape:
    - match: '\\[abfnrtvz''"`{\\]'
      scope: constant.character.escape.luau
    - match: '\\\d{1,3}'
      scope: constant.character.escape.luau
    - match: '\\x[0-9a-fA-F]{2}'
      scope: constant.character.escape.luau
    - match: '\\x\{[0-9a-fA-F]*\}'
      scope: constant.character.escape.luau
    - match: '\\u\{[0-9a-fA-F]*\}'
      scope: constant.character.escape.luau
    - match: \\$
      scope: constant.character.escape.luau

  table:
    - match: '(\{)'
      captures:
        1: punctuation.table.begin.luau
      push:
        - match: '(\})'
          captures:
            1: punctuation.table.end.luau
          pop: true
        - match: '[,;]'
          scope: punctuation.separator.fields.luau
        - include: scope:source.luau

  type-alias-declaration:
    - match: '(?<![^.]\.|:)\b(?:(export)\s+)?(type)\b(?=\s+(?!function\b)[a-zA-Z_][a-zA-Z0-9_]*)'
      captures:
        1: storage.modifier.visibility.luau
        2: storage.type.luau
      push:
        - match: '(?=[),}\]](?!\s*[&|]))|(?=\s*;)|(?=\s*(?:[*+%^]|\/\/?|(?<!\.)\.\.(?!\.)|-(?![->`])|~=|==))|(?=\s*\b(?:and|or|break|class|declare|const|continue|do|else|elseif|end|for|function|if|in|local|public|private|repeat|return|then|until|while)\b)|(?=^\s*$)|(?=^\s*(?:@|\b(?:export\s+)?type\b|\b(?:declare\s+)?extern\s+type\b))|(?=^\s*[a-zA-Z_][a-zA-Z0-9_]*(?:\.[a-zA-Z_][a-zA-Z0-9_]*)*\s*(?:(?:[+\-*/%^]|\.\.)?=(?!=)|\(|\[|:))'
          pop: true
        - include: type_literal
        - match: '='
          scope: keyword.operator.assignment.luau

  type-function:
    - match: '(?<![^.]\.|:)\b(?:(export)\s+)?(type)\s+(function)\b'
      captures:
        1: storage.modifier.visibility.luau
        2: storage.type.luau
        3: keyword.control.luau
      push:
        - meta_scope: meta.function.luau
        - match: '(?<=[\)\-{}\[\]"''])'
          pop: true
        - include: comment
        - include: generics-declaration
        - include: function-parameters
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
          scope: entity.name.type.luau

  type_annotation:
    - match: ':(?!\b([a-zA-Z_][a-zA-Z0-9_]*)\b(?=\s*(?:<<|[({"'']|\[\[)))'
      push:
        - match: (?<=\))(?!\s*->)|=|;|$|(?=\breturn\b)|(?=\bend\b)
          pop: true
        - include: comment
        - include: type_literal

  type_cast:
    - match: (::)
      captures:
        1: keyword.operator.typecast.luau
      push:
        - match: '(?=[),}\]](?!\s*[&|]))|(?=\s*;)|(?=\s*(?:[*+%^]|\/\/?|(?<!\.)\.\.(?!\.)|-(?![->`])|~=|==))|(?=\s*\b(?:and|or|break|class|declare|const|continue|do|else|elseif|end|for|function|if|in|local|public|private|repeat|return|then|until|while)\b)|(?=^\s*$)|(?=^\s*(?:@|\b(?:export\s+)?type\b|\b(?:declare\s+)?extern\s+type\b))|(?=^\s*[a-zA-Z_][a-zA-Z0-9_]*(?:\.[a-zA-Z_][a-zA-Z0-9_]*)*\s*(?:(?:[+\-*/%^]|\.\.)?=(?!=)|\(|\[|:))'
          pop: true
        - include: type_literal

  type_literal:
    - include: comment
    - include: string
    - match: \?|\&|\|
      scope: keyword.operator.type.luau
    - match: '->'
      scope: keyword.operator.type.function.luau
    - match: \b(false)\b
      scope: constant.language.boolean.false.luau
    - match: \b(true)\b
      scope: constant.language.boolean.true.luau
    - match: \b(nil|string|number|integer|boolean|thread|vector|buffer|unknown|never|any)\b
      scope: support.type.primitive.luau
    - match: \b(typeof)\b(\()
      captures:
        1: support.function.luau
        2: punctuation.arguments.begin.typeof.luau
      push:
        - match: (\))
          captures:
            1: punctuation.arguments.end.typeof.luau
          pop: true
        - include: scope:source.luau
    - match: (<)
      captures:
        1: punctuation.definition.typeparameters.begin.luau
      push:
        - match: (>)
          captures:
            1: punctuation.definition.typeparameters.end.luau
          pop: true
        - match: '='
          scope: keyword.operator.assignment.luau
        - include: type_literal
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      scope: entity.name.type.luau
    - match: '\{'
      push:
        - match: '\}'
          pop: true
        # The `read`/`write` variance modifier on an indexer -- `{ read [string]: number }`.
        # Named properties pick theirs up in the rule below, but an indexer has no name,
        # so it needs its own match ahead of the `[` rule.
        - match: '\b(read|write)\b(?=\s*\[)'
          scope: storage.modifier.access.luau
        - match: '\['
          push:
            - match: '\]'
              pop: true
            - include: type_literal
        - match: '\b(?:(read|write)\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\b(:)'
          captures:
            1: storage.modifier.access.luau
            2: variable.property.luau
            3: keyword.operator.type.luau
        - include: type_literal
        - match: '[,;]'
          scope: punctuation.separator.fields.type.luau
    - match: \(
      push:
        - match: \)
          pop: true
        - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b(:)'
          scope: variable.parameter.luau
          captures:
            1: variable.parameter.luau
            2: keyword.operator.type.luau
        - include: type_literal

