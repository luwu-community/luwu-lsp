{
  "Local function": {
    "prefix": "lfn",
    "body": [
      "local function ${1:name}(${2})${3}",
      "    $0",
      "end"
    ]
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2})${3}",
      "    $0",
      "end"
    ]
  },
  "Anonymous function": {
    "prefix": "afn",
    "body": [
      "function(${1})",
      "    $0",
      "end"
    ]
  },
  "Method": {
    "prefix": "method",
    "body": [
      "function ${1:Table}:${2:name}(${3})${4}",
      "    $0",
      "end"
    ]
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "    $0",
      "end"
    ]
  },
  "If else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} then",
      "    $2",
      "else",
      "    $0",
      "end"
    ]
  },
  "For in": {
    "prefix": "for",
    "body": [
      "for ${1:_, item} in ${2:items} do",
      "    $0",
      "end"
    ]
  },
  "Numeric for": {
    "prefix": "fori",
    "body": [
      "for ${1:i} = ${2:1}, ${3:n} do",
      "    $0",
      "end"
    ]
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} do",
      "    $0",
      "end"
    ]
  },
  "Repeat": {
    "prefix": "repeat",
    "body": [
      "repeat",
      "    $0",
      "until ${1:condition}"
    ]
  },
  "Require": {
    "prefix": "req",
    "body": ["local ${1:name} = require(\"${2:./module}\")"]
  },
  "Type alias": {
    "prefix": "type",
    "body": ["type ${1:Name} = ${2:{ }}"]
  },
  "Export type": {
    "prefix": "etype",
    "body": ["export type ${1:Name} = ${2:{ }}"]
  },
  "Protected call": {
    "prefix": "pcall",
    "body": [
      "local ${1:ok}, ${2:result} = pcall(function()",
      "    $0",
      "end)"
    ]
  },
  "Doc comment": {
    "prefix": "doc",
    "body": ["--- ${1:What this is for}"]
  }
}
