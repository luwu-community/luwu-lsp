          "include": "#type_literal"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.luau"
        }
      ]
    },
    "type_annotation": {
      "begin": ":(?!\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*(?:<<|[({\"']|\\[\\[)))",
      "end": "(?<=\\))(?!\\s*->)|=|;|$|(?=\\breturn\\b)|(?=\\bend\\b)",
