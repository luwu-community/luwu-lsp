    "comment": {
      "patterns": [
        {
          "comment": "A `--[[ ... ]]` / `--[=[ ... ]=]` block comment. Only its delimiters and prose are scoped as a comment, not the whole block, so code in a ```luwu / ```luau fence inside it is scoped purely as code and highlights like it would outside the comment.",
          "begin": "--\\[(=*)\\[",
          "beginCaptures": {
            "0": {
              "name": "comment.block.luau"
            }
          },
          "end": "\\]\\1\\]",
          "endCaptures": {
            "0": {
              "name": "comment.block.luau"
            }
          },
          "patterns": [
            {
              "begin": "(```luwu)\\s*$",
              "while": "^(?!\\s*```)",
              "beginCaptures": {
                "1": {
                  "name": "comment.block.luau"
                }
              },
              "patterns": [
                {
                  "include": "source.luwu"
                }
              ],
              "contentName": "meta.embedded.block.luwu"
            },
            {
              "begin": "(```luau?)\\s*$",
              "while": "^(?!\\s*```)",
              "beginCaptures": {
                "1": {
                  "name": "comment.block.luau"
                }
              },
              "patterns": [
                {
                  "include": "source.luau"
                }
              ],
              "contentName": "meta.embedded.block.luau"
            },
            {
              "match": "(```)",
              "captures": {
                "1": {
                  "name": "comment.block.luau"
                }
              }
            },
            {
              "include": "#doc_comment_tags"
            },
            {
              "comment": "Comment prose. Stops at `]`, a backtick and `@` so the end delimiter, fences and doc tags can still match.",
              "match": "[^\\]`@]+",
              "name": "comment.block.luau"
            },
            {
              "match": "[\\]`@]",
              "name": "comment.block.luau"
            }
          ]
        },
        {
          "begin": "(--!)(optimize|native)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.directive.luau"
            },
            "2": {
              "name": "keyword.control.directive.luau"
            }
          },
          "end": "\\n",
          "name": "meta.directive.codegen.luau",
          "patterns": [
