            },
            {
              "include": "#type_literal"
            }
          ]
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "entity.name.type.luau"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "comment": "The `read`/`write` variance modifier on an indexer -- `{ read [string]: number }`. Named properties pick theirs up in the rule below, but an indexer has no name, so it needs its own match ahead of the `[` rule.",
              "match": "\\b(read|write)\\b(?=\\s*\\[)",
              "name": "storage.modifier.access.luau"
            },
            {
              "begin": "\\[",
              "end": "\\]",
              "patterns": [
