{
  "comments": {
    // symbol used for single line comment. Remove this entry if your language does not support line comments
    "lineComment": "--",
    // symbols used for start and end a block comment. Remove this entry if your language does not support block comments
    "blockComment": ["--[[", "]]"]
  },
  // symbols used as brackets. A Luwu `.{...}` (destructuring, or building a table)
  // is a bracket of its own so that the `.` colors with its `{`; the grammar
  // scopes `.{` as one token, which the bracket colorizer needs.
  "brackets": [
    ["{", "}"],
    [".{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  // symbols that are auto closed when typing
  // NOTE: a long comment/string opener ("--[=[", "[==[") auto-closes as a plain
  // "]]" here, because it is just the single "[" pair firing twice. The level
  // markers are put back by the fixup in src/longBracketAutoClose.ts.
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  // symbols that that can be used to surround a selection
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["<", ">"]
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    [".{", "}"],
    ["[", "]"],
    ["(", ")"],
    // an explicit type instantiation, `f<<T>>()`, is one pair rather than two
    // nested `<>` pairs coloured a level apart
    ["<<", ">>"],
    ["<", ">"]
  ],

  "autoCloseBefore": ">}])` \n\t",

  "indentationRules": {
    // the first alternative steps over quoted strings whole, so a keyword inside
    // one (`"from type function"`) doesn't indent the next line.
    // the second alternative is a class/trait header (`export class Foo`,
    // `trait Meower(tag: string) needs Animal`, `declare class type Bar`,
    // `export declare trait type Baz`), whose body is closed by `end`
    "increaseIndentPattern": "(?:^(?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|`(?:[^`\\\\]|\\\\.)*`|(?!\\-\\-)[^\"'`])*((\\b(function|do|repeat)\\b(?:(?!\\b(end|until)\\b)(?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|`(?:[^`\\\\]|\\\\.)*`|(?!\\-\\-)[^\"'`]))*)|(\\{\\s*)|(\\b(then|else)\\b[;\\s]*))(\\-\\-.*)*$)|(?:^\\s*(?:export\\s+)?(?:declare\\s+(?:class|trait)\\s+type|class|trait)\\s+[A-Za-z_]((?!\\-\\-|\\bend\\b).)*(\\-\\-.*)?$)",
    // `else` isn't here: in a `match` or an if-else expression it's an arm, level with the ones above it, and this
    // pattern can't tell. src/elseIndent.ts dedents an `if` statement's `else` instead.
    "decreaseIndentPattern": "^\\s*((\\b(end|until)\\b)|(\\})|(\\)))"
  },

  "onEnterRules": [
    {
      // keep a `--- doc comment` going on the next line, like rust's `///`.
      // `(?!-)` so a `-----` separator line isn't continued
      "beforeText": "^\\s*---(?!-)",
      "action": {
        "indent": "none",
        "appendText": "--- "
      }
    },
    {
      "beforeText": "^\\s*(?:local\\s+)?function\\s*[\\w.:]*\\s*\\([^)]*\\)\\s*$",
      "afterText": "^\\s*end\\b",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^\\s*(?:export\\s+)?(?:declare\\s+(?:class|trait)\\s+type|class|trait)\\s+[A-Za-z_]((?!\\-\\-|\\bend\\b).)*$",
      "afterText": "^\\s*end\\b",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      // an `else` arm or a `give` that already has its value ends its expression (a `match`, an if-else or a `do`
      // expression), so the next line goes back out to the code around it. `else if` goes on with the chain.
      "beforeText": "^\\s*(?:else\\s+(?!if\\b)|give\\s+)(?!--)\\S",
      "action": {
        "indent": "outdent"
      }
    },
    {
      // a `give` with no value yet: the value goes on the next line
      "beforeText": "^\\s*give\\s*(?:--.*)?$",
      "action": {
        "indent": "indent"
      }
    },
    {
      // a `match` header (`match x`, `match const v = x`), whose `case` arms go on the lines below it
      "beforeText": "(?<![.:\\w])match\\s+(?!--)(?:local\\b|const\\b|not\\b|[^\\s=.,:;)\\]}])((?!\\bcase\\b).)*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "\\b(?:then|do|else)\\s*$",
      "afterText": "^\\s*(?:end|else|elseif)\\b",
      "action": {
        "indent": "indentOutdent"
      }
    }
  ]
}
